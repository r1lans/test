rules_version = '2';
// Global Education Karshi — who may read and change what.
// Roles live in centers/{centre}/members/{uid}: { role: 'director' | 'admin' | 'teacher', teacherId, name }
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function memberDoc(cid) { return /databases/$(db)/documents/centers/$(cid)/members/$(request.auth.uid); }
    function me(cid) { return get(memberDoc(cid)).data; }
    function hasRole(cid, roles) { return signedIn() && exists(memberDoc(cid)) && me(cid).role in roles; }
    // a register page is named "<groupId>~<date>"; a teacher may fill it only for his own group
    function ownGroup(cid, id) { return get(/databases/$(db)/documents/centers/$(cid)/groups/$(id.split('~')[0])).data.teacher == me(cid).teacherId; }

    match /centers/{cid} {
      // staff list: only the director manages it; everyone can read his own entry
      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || hasRole(cid, ['director']));
        allow write: if hasRole(cid, ['director']);
      }
      match /{coll}/{id} {
        allow read: if coll != 'members' && (
          hasRole(cid, ['director', 'admin']) ||
          (coll in ['students', 'groups', 'teachers', 'courses', 'mocks', 'att', 'hw'] && hasRole(cid, ['teacher'])));
        allow write: if coll != 'members' && (
          hasRole(cid, ['director', 'admin']) ||
          (coll in ['att', 'hw'] && hasRole(cid, ['teacher']) && ownGroup(cid, id)));
      }
    }
  }
}
